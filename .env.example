# ── Pinecone ────────────────────────────────────────────────────────────────
# Get your API key from https://app.pinecone.io → API Keys
PINECONE_API_KEY=your_pinecone_api_key_here

# Name of the Pinecone index to create / reuse
PINECONE_INDEX_NAME=rag-qwen-test

# Pinecone serverless spec — choose the cloud and region closest to you.
# Supported values for cloud: aws | gcp | azure
# Common regions (aws): us-east-1 | us-west-2 | eu-west-1
# Common regions (gcp): us-central1 | europe-west1
# See full list: https://docs.pinecone.io/guides/indexes/create-an-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── Ollama / Local LLM ───────────────────────────────────────────────────────
# Base URL of your local Ollama server (default port 11434)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use — must be pulled first: ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b

# ── Embeddings ───────────────────────────────────────────────────────────────
# HuggingFace sentence-transformers model for embeddings.
# all-MiniLM-L6-v2 produces 384-dimensional vectors (cosine similarity).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
